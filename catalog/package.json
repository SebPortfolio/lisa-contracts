{
  "name": "@sebportfolio/lisa-catalog-api",
  "version": "0.1.2",
  "scripts": {
    "clean": "node -e \"fs.rmSync('src', { recursive: true, force: true }); fs.rmSync('dist', { recursive: true, force: true });\"",
    "generate": "npx @openapitools/openapi-generator-cli generate -i ./catalog.yaml -g typescript-angular -o ./src --additional-properties=serviceSuffix=Api,modelSuffix=Wdto,ngVersion=18",
    "compile": "ng-packagr -p ng-package.json",
    "build": "npm run clean && npm run generate && npm run compile"
  },
  "devDependencies": {
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "ng-packagr": "^18.2.1",
    "rxjs": "^7.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
